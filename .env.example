# ==============================================================================
# 🚀 AGENTFLOW MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env, apps/web/.env.local, and apps/api/.env for local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND NEXT.JS WEB APP CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Public Supabase API Endpoint URL
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Public Supabase Anonymous Key (Client-side RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend FastAPI HTTP API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend FastAPI WebSockets Stream URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# ------------------------------------------------------------------------------
# 2. BACKEND FASTAPI PYTHON ENGINE CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
# Application Environment (development, staging, production)
ENVIRONMENT=development

# API Prefix
API_V1_STR=/api/v1

# Backend Secret Security Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string

# Local / Remote Ollama LLM Service URL
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama Engine Model for Agents
OLLAMA_DEFAULT_MODEL=llama3:latest

# Pluggable Search Tool API Key (Tavily or Serper)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Local ChromaDB Vector Storage Directory
CHROMADB_PERSIST_DIR=./chromadb

# Supabase Database Service Role Key (Backend administrative queries)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
